# Konfigurasi Koneksi Database PostgreSQL
DATABASE_URL=

# Nonaktifkan Hot Module Replacement (HMR) saat edit kode
DISABLE_HMR=

# Alamat dasar server API backend untuk frontend (opsional).
# Kosongkan untuk mode produksi (otomatis menggunakan alamat yang sama dengan website).
# Isi dengan URL backend uji/staging (misal: https://api.staging.example.com) untuk beralih ke server uji.
VITE_API_URL=

# Daftar domain/origin yang diizinkan mengakses CORS dan Socket.IO (dipisah koma).
# Jika kosong, server tidak akan mengizinkan request dari alamat/origin lain.
# Contoh: http://localhost:5173,https://klien.smartcleaning.com
ALLOWED_ORIGINS=